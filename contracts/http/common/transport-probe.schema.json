{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:backend-lab:transport-probe:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "audience",
    "nonce",
    "expectedRevision",
    "issuedAt",
    "validUntil",
    "requestBinding"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "action": {
      "enum": [
        "ADMISSION_TRANSPORT",
        "FENCE_TRANSPORT",
        "BUNDLE_TRANSPORT",
        "PUBLICATION_TRANSPORT",
        "OPS_TRANSPORT"
      ]
    },
    "audience": {
      "enum": [
        "identity",
        "content",
        "learning"
      ]
    },
    "nonce": {
      "type": "string",
      "format": "uuid"
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "max9223372036854775807; exact range checked by provider"
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "validUntil": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "requestBinding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Lab transport probe; no user admission. Bigint range and cross-field binding/deadline enforced by codec/provider."
}

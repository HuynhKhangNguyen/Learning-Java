{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backend-lab.invalid/contracts/http/content/internal/publication/candidate-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "parentRevision", "targetRevision", "bundle", "components", "references", "prerequisiteEdges", "coverage", "review", "impacts", "oldVersions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "parentRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "targetRevision": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
    "bundle": {"$ref": "#/definitions/bundle"},
    "components": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/definitions/component"}},
    "references": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/definitions/reference"}},
    "prerequisiteEdges": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/definitions/edge"}},
    "coverage": {"$ref": "#/definitions/coverageReport"},
    "review": {"$ref": "#/definitions/reviewReport"},
    "impacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/definitions/impact"}},
    "oldVersions": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/definitions/oldVersion"}}
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "bundleId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/definitions/bundleId"}, "sha256": {"$ref": "#/definitions/sha256"}}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "sha256"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "type": {"enum": ["catalog", "content", "rubric", "case"]},
        "version": {"$ref": "#/definitions/version"},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "expectedType"],
      "properties": {
        "from": {"$ref": "#/definitions/id"},
        "to": {"$ref": "#/definitions/id"},
        "expectedType": {"enum": ["catalog", "content", "rubric", "case"]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/definitions/id"}, "to": {"$ref": "#/definitions/id"}}
    },
    "coverageReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "subjectVersion", "subjectSha256", "status"],
      "properties": {
        "reportId": {"type": "string", "minLength": 10, "maxLength": 128, "pattern": "^coverage-[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "subjectVersion": {"const": 1},
        "subjectSha256": {"$ref": "#/definitions/sha256"},
        "status": {"const": "PASSED"}
      }
    },
    "reviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "subjectVersion", "subjectSha256", "status"],
      "properties": {
        "reportId": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^review-[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "subjectVersion": {"const": 1},
        "subjectSha256": {"$ref": "#/definitions/sha256"},
        "status": {"const": "APPROVED"}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "classification", "affectedVersions"],
      "properties": {
        "capabilityId": {"$ref": "#/definitions/id"},
        "classification": {"enum": ["COSMETIC", "REVERIFY", "WITHDRAWN", "INVALID_OLD_RUBRIC"]},
        "affectedVersions": {"type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": {"$ref": "#/definitions/version"}}
      }
    },
    "oldVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "version", "newAttemptAllowed", "submitAllowed", "finalizeAllowed", "currentEvidencePolicy", "bodyAvailable", "reason"],
      "properties": {
        "capabilityId": {"$ref": "#/definitions/id"},
        "version": {"$ref": "#/definitions/version"},
        "newAttemptAllowed": {"type": "boolean"},
        "submitAllowed": {"type": "boolean"},
        "finalizeAllowed": {"type": "boolean"},
        "currentEvidencePolicy": {"enum": ["RETAIN", "REVERIFY", "WITHDRAW", "REVIEW"]},
        "bodyAvailable": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"}
      },
      "oneOf": [
        {"properties": {"newAttemptAllowed": {"const": true}, "submitAllowed": {"const": true}, "finalizeAllowed": {"const": true}, "currentEvidencePolicy": {"const": "RETAIN"}, "bodyAvailable": {"const": true}}},
        {"properties": {"newAttemptAllowed": {"const": false}, "submitAllowed": {"const": true}, "finalizeAllowed": {"const": true}, "currentEvidencePolicy": {"const": "REVERIFY"}, "bodyAvailable": {"const": true}}},
        {"properties": {"newAttemptAllowed": {"const": false}, "submitAllowed": {"const": false}, "finalizeAllowed": {"const": true}, "currentEvidencePolicy": {"const": "WITHDRAW"}, "bodyAvailable": {"const": true}}},
        {"properties": {"newAttemptAllowed": {"const": false}, "submitAllowed": {"const": false}, "finalizeAllowed": {"const": false}, "currentEvidencePolicy": {"const": "REVIEW"}, "bodyAvailable": {"const": true}}}
      ]
    }
  }
}

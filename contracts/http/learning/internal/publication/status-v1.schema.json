{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,"required":["contractVersion","operationId","phase","state","parentRevision","targetRevision","bundleId","bundleSha256","manifestSha256","realmId","producerGeneration","participantGeneration","deliverySequence","commandSha256"],"properties":{"contractVersion":{"const":1},"operationId":{"type":"string","format":"uuid"},"phase":{"enum":["STAGE","FENCE","RELEASE","ABORT"]},"state":{"enum":["STAGED","FENCED","RELEASED","ABORTED"]},"parentRevision":{"type":"integer","minimum":1,"maximum":9007199254740990},"targetRevision":{"type":"integer","minimum":2,"maximum":9007199254740991},"bundleId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},"bundleSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"manifestSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"realmId":{"type":"string","format":"uuid"},"producerGeneration":{"type":"string","format":"uuid"},"participantGeneration":{"type":"string","format":"uuid"},"deliverySequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"commandSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"allOf":[{"if":{"properties":{"phase":{"const":"STAGE"}}},"then":{"properties":{"state":{"const":"STAGED"}}}},{"if":{"properties":{"phase":{"const":"FENCE"}}},"then":{"properties":{"state":{"const":"FENCED"}}}},{"if":{"properties":{"phase":{"const":"RELEASE"}}},"then":{"properties":{"state":{"const":"RELEASED"}}}},{"if":{"properties":{"phase":{"const":"ABORT"}}},"then":{"properties":{"state":{"const":"ABORTED"}}}}]}

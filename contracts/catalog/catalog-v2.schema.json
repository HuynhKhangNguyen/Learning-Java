{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backend-lab.invalid/contracts/catalog/catalog-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "topics",
    "competencies",
    "placements",
    "milestones",
    "units",
    "packages",
    "aliases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "catalogVersion": {
      "$ref": "#/definitions/positive"
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/topic"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "competencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/competency"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/placement"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/milestone"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/unit"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/package"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/alias"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "definitions": {
    "topicId": {
      "type": "string",
      "pattern": "^TOP-[A-Z]+-[0-9]{3}$"
    },
    "capId": {
      "type": "string",
      "pattern": "^CAP-[A-Z]+-[0-9]{3}-[A-Z]$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "topic"
            },
            "id": {
              "$ref": "#/definitions/topicId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "competency"
            },
            "id": {
              "$ref": "#/definitions/capId"
            }
          }
        }
      ]
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "level",
        "knowledgeAreas",
        "prerequisites",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/topicId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "status": {
          "enum": [
            "planned",
            "draft",
            "published",
            "withdrawn"
          ]
        },
        "level": {
          "enum": [
            "C",
            "M",
            "S"
          ]
        },
        "knowledgeAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^K[0-9]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/selector"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "pattern": "^docs/curriculum/[a-z-]+\\.md$"
        }
      }
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicId",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/capId"
        },
        "topicId": {
          "$ref": "#/definitions/topicId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "placement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roadmap",
            "stage",
            "topicId"
          ],
          "properties": {
            "roadmap": {
              "const": "java-backend"
            },
            "stage": {
              "type": "string",
              "pattern": "^S(?:0[0-9]|10)$"
            },
            "topicId": {
              "$ref": "#/definitions/topicId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roadmap",
            "stage",
            "topicId"
          ],
          "properties": {
            "roadmap": {
              "const": "devops"
            },
            "stage": {
              "type": "string",
              "pattern": "^DS(?:0[0-9]|1[01])$"
            },
            "topicId": {
              "$ref": "#/definitions/topicId"
            }
          }
        }
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "readiness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DP[0-5]$"
        },
        "readiness": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/selector"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "topicIds",
        "competencyIds",
        "canonicalTopicId",
        "viewedTopicIds",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UNIT-[A-Z0-9-]+$"
        },
        "version": {
          "$ref": "#/definitions/positive"
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "withdrawn"
          ]
        },
        "topicIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/topicId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "competencyIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "canonicalTopicId": {
          "$ref": "#/definitions/topicId"
        },
        "viewedTopicIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/topicId"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "title": {
          "$ref": "#/definitions/localized"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "paragraph"
              },
              "text": {
                "$ref": "#/definitions/localized"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicIds",
        "unitIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PKG-[A-Z0-9-]+$"
        },
        "topicIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/topicId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unitIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UNIT-[A-Z0-9-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyId",
        "topicId"
      ],
      "properties": {
        "legacyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "topicId": {
          "$ref": "#/definitions/topicId"
        }
      }
    }
  }
}
